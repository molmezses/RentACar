generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCategory {
  ECONOMY
  COMPACT
  SEDAN
  SUV
  LUXURY
  VAN
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum VehicleCurrency {
  TRY
  USD
  EUR
}

enum FleetStatus {
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  application TenantApplication?
  admin       TenantAdmin?

  vehicles Vehicle[]
}

model Vehicle {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plate        String
  make         String
  model        String
  modelYear    Int
  category     VehicleCategory
  transmission Transmission
  fuelType     FuelType
  seatCount    Int
  odometerKm   Int

  dailyPrice        Decimal         @db.Decimal(12, 2)
  currency          VehicleCurrency
  depositAmount     Decimal?        @db.Decimal(12, 2)
  includedMileageKm Int?
  extraKmPrice      Decimal?        @db.Decimal(12, 2)

  fleetStatus FleetStatus @default(ACTIVE)

  color                String?
  vin                  String?
  internalCode         String?
  trim                 String?
  doorCount            Int?
  currentLocationLabel String?
  notes                String?
  hasAirConditioning   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, plate])
  @@index([tenantId, fleetStatus])
  @@index([tenantId, createdAt])
}

model TenantApplication {
  id           String                  @id @default(cuid())
  companyName  String
  slug         String
  contactName  String
  contactEmail String
  contactPhone String
  status       TenantApplicationStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TenantAdmin {
  id           String  @id @default(cuid())
  tenantId     String  @unique
  email        String  @unique
  passwordHash String?

  emailVerifiedAt DateTime?
  activatedAt     DateTime?
  disabledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  activationTokens     TenantActivationToken[]
  invitationDeliveries InvitationDelivery[]

  sessions TenantAdminSession[]
}

model TenantAdminSession {
  id               String @id @default(cuid())
  tenantAdminId    String
  refreshTokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantAdmin TenantAdmin @relation(fields: [tenantAdminId], references: [id], onDelete: Restrict)

  @@index([tenantAdminId])
  @@index([expiresAt])
}

model TenantActivationToken {
  id            String    @id @default(cuid())
  tenantAdminId String
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  tenantAdmin TenantAdmin @relation(fields: [tenantAdminId], references: [id], onDelete: Restrict)

  delivery InvitationDelivery?

  @@index([tenantAdminId, expiresAt])
}

enum InvitationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model InvitationDelivery {
  id                String                   @id @default(cuid())
  tenantAdminId     String
  activationTokenId String                   @unique
  recipientEmail    String
  encryptedToken    String?
  status            InvitationDeliveryStatus @default(PENDING)

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lockedUntil   DateTime?
  sentAt        DateTime?
  lastErrorCode String?

  claimId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantAdmin TenantAdmin @relation(fields: [tenantAdminId], references: [id], onDelete: Restrict)

  activationToken TenantActivationToken @relation(fields: [activationTokenId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([tenantAdminId])
}
